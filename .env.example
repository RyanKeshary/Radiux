# ==============================================================================
# CodeCollab Environment Variables Specification
# ==============================================================================

# ==============================================================================
# 1. VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Configure these in your Vercel Project Settings -> Environment Variables:

# Supabase API URL (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production Frontend URL
NEXT_PUBLIC_APP_URL=https://code-collab-ide.vercel.app

# Render Backend WebSocket URL (wss:// for production, ws:// for local)
NEXT_PUBLIC_WS_URL=wss://codecollab-backend-isjt.onrender.com

# Render Backend REST API URL (https:// for production, http:// for local)
NEXT_PUBLIC_API_URL=https://codecollab-backend-isjt.onrender.com


# ==============================================================================
# 2. RENDER BACKEND CONFIGURATION
# ==============================================================================
# Configure these in your Render Web Service -> Environment:

# Port (defaults to 10000 on Render)
PORT=10000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (your deployed Vercel frontend URL)
ALLOWED_ORIGIN=https://code-collab-ide.vercel.app,https://codecollab-ide-kappa.vercel.app,http://localhost:3000

# Supabase Project URL for server-side verification
SUPABASE_URL=https://rdhwzezrmgkgsbpwznrz.supabase.co

# Supabase Service Role Secret (NEVER expose to frontend or client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ==============================================================================
# 3. LOCAL DEVELOPMENT DEFAULTS
# ==============================================================================
# For local testing, .env.local can contain:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://localhost:1234
# NEXT_PUBLIC_API_URL=http://localhost:1234
# PORT=1234
# NODE_ENV=development
# ALLOWED_ORIGIN=http://localhost:3000
