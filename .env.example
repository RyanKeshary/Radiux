# ==============================================================================
# Radiux Environment Variables Specification
# Copy this to .env.local for local development.
# Set these directly in Vercel and Render dashboards for production.
# NEVER commit .env.local to git.
# ==============================================================================

# ==============================================================================
# 1. VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Configure these in your Vercel Project Settings -> Environment Variables:

# Supabase API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Production Frontend URL (the canonical public domain)
NEXT_PUBLIC_APP_URL=https://radiux-app.vercel.app

# Render Backend WebSocket URL
NEXT_PUBLIC_WS_URL=wss://codecollab-backend-isjt.onrender.com

# Render Backend REST API URL
NEXT_PUBLIC_API_URL=https://codecollab-backend-isjt.onrender.com


# ==============================================================================
# 2. RENDER BACKEND CONFIGURATION
# ==============================================================================
# Configure these in your Render Web Service -> Environment:

# Port (Render assigns this dynamically, default 10000)
PORT=10000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (comma-separated) â€” must include all frontend URLs
ALLOWED_ORIGIN=https://radiux-app.vercel.app,https://codecollab-backend-isjt.onrender.com,http://localhost:3000

# Supabase Project URL for server-side auth verification
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret (NEVER expose to frontend or any NEXT_PUBLIC_* variable)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ==============================================================================
# 3. LOCAL DEVELOPMENT DEFAULTS (.env.local)
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://localhost:1234
# NEXT_PUBLIC_API_URL=http://localhost:1234
# PORT=1234
# NODE_ENV=development
# ALLOWED_ORIGIN=http://localhost:3000


# ==============================================================================
# 3b. BACKEND AUTHORIZATION (REQUIRED â€” server/websocket.mjs)
# ==============================================================================
# The companion server authenticates every REST + WebSocket request against
# Supabase Auth and resolves each caller's project role from the database.
# It FAILS CLOSED: if these are missing, all requests are refused with HTTP 503.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#
# LOCAL DEVELOPMENT ESCAPE HATCH â€” read this before using it:
# Setting RADIUX_ALLOW_ANONYMOUS=1 grants every caller OWNER privileges with no
# identity check whatsoever (arbitrary command execution, Git writes, live PTY
# shells). It prints a loud warning at boot. NEVER set this in production.
# RADIUX_ALLOW_ANONYMOUS=1


# ==============================================================================
# 4. RADIUX AI AGENT & WORKSPACE INTELLIGENCE (SERVER-SIDE ONLY)
# ==============================================================================
# CRITICAL SECURITY RULE:
# Never prefix GROQ_API_KEY with NEXT_PUBLIC_!
# Never expose to browser bundle or commit to repository.

# Groq Cloud API Key for AI Coding Agent (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Default coding model. Must be a Groq model with tool-calling support.
# Verified options: llama-3.3-70b-versatile, openai/gpt-oss-120b
AI_MODEL=llama-3.3-70b-versatile

# Maximum iterative tool calls per agent task
AI_MAX_STEPS=20

# Token budget thresholds
AI_MAX_CONTEXT=128000
AI_MAX_OUTPUT=8192

# Default security permission mode: READ_ONLY | ASSISTED | AUTONOMOUS
AI_DEFAULT_PERMISSION_MODE=ASSISTED


# ==============================================================================
# 5. RADIUX ADMINISTRATIVE ACCESS (SERVER-SIDE ONLY)
# ==============================================================================
# Master administrator credentials for system management.
# NEVER commit real credentials. Set these in Vercel/Render env dashboards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_password_manager_generated_secret

# HMAC signing secret for admin tokens (generate a long random string)
ADMIN_SECRET=your_long_random_admin_secret_key_here


# ==============================================================================
# 6. DEPLOYMENT PROVIDER API KEYS (SERVER-SIDE ONLY)
# ==============================================================================
# Used server-side for Vercel / Render API calls. Never expose to browser.
VERCEL_API_TOKEN=your_vercel_api_token_here
RENDER_API_KEY=your_render_api_key_here
