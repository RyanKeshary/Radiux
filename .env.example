# ==============================================================================
# Radiux Environment Variables Specification
# ==============================================================================

# ==============================================================================
# 1. VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Configure these in your Vercel Project Settings -> Environment Variables:

# Supabase API URL
NEXT_PUBLIC_SUPABASE_URL=https://rdhwzezrmgkgsbpwznrz.supabase.co

# Supabase Public Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_LJNOLmfuxnsbaxnRBcbQNg_TLDDbUfL

# Production Frontend URL
NEXT_PUBLIC_APP_URL=https://code-collab-ide.vercel.app

# Render Backend WebSocket URL
NEXT_PUBLIC_WS_URL=wss://codecollab-backend-isjt.onrender.com

# Render Backend REST API URL
NEXT_PUBLIC_API_URL=https://codecollab-backend-isjt.onrender.com


# ==============================================================================
# 2. RENDER BACKEND CONFIGURATION
# ==============================================================================
# Configure these in your Render Web Service -> Environment:

# Port (Render assigns this dynamically, default 10000)
PORT=10000

# Node Environment
NODE_ENV=production

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGIN=https://code-collab-ide.vercel.app,https://codecollab-ide-kappa.vercel.app,http://localhost:3000

# Supabase Project URL for server-side auth verification
SUPABASE_URL=https://rdhwzezrmgkgsbpwznrz.supabase.co

# Supabase Service Role Secret (NEVER expose to frontend or any NEXT_PUBLIC_* variable)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ==============================================================================
# 3. LOCAL DEVELOPMENT DEFAULTS (.env.local)
# ==============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://rdhwzezrmgkgsbpwznrz.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_LJNOLmfuxnsbaxnRBcbQNg_TLDDbUfL
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://localhost:1234
# NEXT_PUBLIC_API_URL=http://localhost:1234
# PORT=1234
# NODE_ENV=development
# ALLOWED_ORIGIN=http://localhost:3000

# ==============================================================================
# 4. RADIUX AI AGENT & WORKSPACE INTELLIGENCE (SERVER-SIDE ONLY)
# ==============================================================================
# CRITICAL SECURITY RULE:
# Never prefix GROQ_API_KEY with NEXT_PUBLIC_!
# Never expose to browser bundle or commit to repository.

# Groq Cloud API Key for AI Coding Agent (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Default coding model (Groq tool-calling capable)
AI_MODEL=llama-3.3-70b-versatile

# Maximum iterative tool calls per agent task
AI_MAX_STEPS=20

# Token budget thresholds
AI_MAX_CONTEXT=128000
AI_MAX_OUTPUT=8192

# Default security permission mode: READ_ONLY | ASSISTED | AUTONOMOUS
AI_DEFAULT_PERMISSION_MODE=ASSISTED

