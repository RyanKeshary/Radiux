# ==============================================================================
# CodeCollab Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (Used exclusively by server/websocket.mjs for DB operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Auth URL Configuration:
# In Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: http://localhost:3000 (Local) or https://your-domain.com (Production)
# - Redirect URLs: http://localhost:3000/** (Local) or https://your-domain.com/** (Production)

# ------------------------------------------------------------------------------
# 2. Application & Backend URLs
# ------------------------------------------------------------------------------
# Frontend Application URL (used for OAuth redirects and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Centralized WebSocket Server URL (used by Monaco Yjs, Chat, Activity, Terminal, Voice)
# Local: ws://localhost:1234
# Production: wss://your-backend.railway.app or wss://collab.yourdomain.com
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# Backend REST API Server URL (used for Git operations, terminal execution, project downloads)
# Local: http://localhost:1234
# Production: https://your-backend.railway.app or https://collab.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:1234

# ------------------------------------------------------------------------------
# 3. WebSocket / API Backend Server Configuration (server/websocket.mjs)
# ------------------------------------------------------------------------------
PORT=1234
NODE_ENV=development

# Allowed CORS Origins (comma-separated or single domain)
ALLOWED_ORIGIN=http://localhost:3000
